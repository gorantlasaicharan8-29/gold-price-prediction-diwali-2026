# Example Frontend Environment Configuration for React/Vite
# Copy this file to .env for local development: cp .env.example .env
# Safe to commit to version control — DO NOT put real secrets here.

# Backend API Base URL
# Vite environment variables MUST start with the VITE_ prefix to be exposed to client-side code.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production usage example (configured in host platform e.g. Vercel/Netlify):
# VITE_API_BASE_URL=https://<your-production-api-domain>
